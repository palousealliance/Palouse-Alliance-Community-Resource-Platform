# ----------------------------------------------------
# Primary Site / Domain Configuration
# ----------------------------------------------------
# Setting this single variable automatically configures:
# 1. Outgoing subscriber event links (SITE_URL)
# 2. Unsubscribe links in emails (API_URL)
# 3. CORS allowed origins (CORS_ORIGIN for both www and apex domain)
SITE_URL=https://www.palousealliance.org

# ----------------------------------------------------
# Supabase Configuration
# ----------------------------------------------------
# Public client URL and anon key (used in src/lib/supabase.js)
VITE_SUPABASE_URL=you_supabse_public_key
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# Admin secret key (bypasses RLS for backend API operations in index.js)
SUPABASE_SECRET_KEY=your_supabase_secret_key

# Supabase Storage bucket for the history document (optional, defaults to "history-pdf")
VITE_HISTORY_PDF_BUCKET=history-pdf

# ----------------------------------------------------
# Email & Notification Settings
# ----------------------------------------------------
# Secret used for HMAC signing of email verification codes and unsubscribe tokens
SUBSCRIBE_SECRET=your_subscribe_secret_random_hex_string

# Gmail SMTP credentials for sending event/subscription emails
GMAIL_USER=your_email@gmail.com
GMAIL_APP_PASSWORD=your_gmail_app_password
